#!/usr/bin/env bash
# Refuse to force-push or delete main. GitHub's free org plan can't protect branches in
# private repos, so this hook is the guard. Installed with: git config core.hooksPath git-hooks
set -euo pipefail

zero=0000000000000000000000000000000000000000
status=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = refs/heads/main ] || continue
  if [ "${local_sha//0/}" = "" ]; then
    echo "pre-push: refusing to delete main." >&2
    status=1
  elif [ "$remote_sha" != "$zero" ] && ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing to force-push main (it would drop commits already on GitHub)." >&2
    echo "pre-push: run 'git pull' and push again; to undo a pushed commit, use 'git revert'." >&2
    status=1
  fi
done
exit $status
